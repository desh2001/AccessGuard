# ==============================================================================
# AccessGuard Ecosystem - Complete .gitignore
# Covers: Root, backend/, frontend/, ml/ (Dialog Final ML), and accesslog-main/
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
ENV/
env.bak/
venv.bak/

# Bytecode & Caches
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
*/**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 2. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
*/**/node_modules/

# Frontend Dist & Cache
dist/
*/dist/
*/**/dist/
.vite/
*/.vite/
*/**/.vite/
.parcel-cache/
.next/
out/
.nuxt/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12

# Whitelist safe configuration templates
!**/.env.example
!*.env.example

# ------------------------------------------------------------------------------
# 4. Databases & Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
backend/accessguard.db
ml/backend/access_governance.db
ml/backend/*.db
accesslog-main/*.db
*.dump
*.sql.gz

# Docker volume mounts (if bound locally)
pgdata/
*/pgdata/
db_data/
*/db_data/

# ------------------------------------------------------------------------------
# 5. Machine Learning Models & Artifacts
# ------------------------------------------------------------------------------
*.joblib
*.pkl
*.h5
*.onnx
ml/backend/ml_artifacts/*.joblib
ml/backend/ml_artifacts/*.json
backend/ml_artifacts/*.joblib
backend/ml_artifacts/*.json

# Keep placeholder .gitkeep in artifact directories if present
!**/ml_artifacts/.gitkeep

# ------------------------------------------------------------------------------
# 6. Logs & Spool Files
# ------------------------------------------------------------------------------
*.log
logs/
*/logs/
*.spool
backend/sample_imports/ftp_spool/*.tmp

# ------------------------------------------------------------------------------
# 7. Operating System & Local Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 8. IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
*/.vscode/
.idea/
*/.idea/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
