# Copy to .env and replace ALL CHANGE_ME values before running.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS_GENERATE_WITH_OPENSSL
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEMO_REVIEWER_PASSWORD=CHANGE_ME_REVIEWER_PASSWORD
# Optional read-only GitHub org inventory (limit: 30 repos, 100 collaborators each)
GITHUB_ORG=
GITHUB_TOKEN=

# Application/system-owner review assignments, by platform, override employee line manager.
# Values must be existing reviewer usernames (in MVP, "reviewer").
PLATFORM_REVIEWERS_JSON={"GitHub":"reviewer","Linux":"reviewer","Windows AD":"reviewer"}

# V6 ML pilot/model integrity: set strong secrets in protected environments.
# AEGIS_MODEL_SIGNING_KEY=USE_SECURE_SECRET_MANAGER_NOT_THIS_EXAMPLE
# AEGIS_REQUIRE_SIGNED_MODELS=true
# AEGIS_PILOT_SIGNING_KEY=USE_SECURE_SECRET_MANAGER_NOT_THIS_EXAMPLE
# AEGIS_REQUIRE_SIGNED_PILOTS=true
