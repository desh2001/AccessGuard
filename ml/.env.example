# Generate a random 32+ character value and set the SAME value in the root backend.
ML_SERVICE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Artifact verification / storage
AEGIS_PLATFORM_MODEL_DIR=./backend/ml_artifacts/platforms
AEGIS_MODEL_SIGNING_KEY=
AEGIS_REQUIRE_SIGNED_MODELS=false

# Only a 90-day model is currently supported. Do not reduce the coverage gate
# without an independently approved telemetry coverage policy.
MIN_MODEL_COVERAGE_FRACTION=0.995
